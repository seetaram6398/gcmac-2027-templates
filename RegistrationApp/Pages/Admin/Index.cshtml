@page
@model AdminModel
@{
    ViewData["Title"] = "Registrations";
}

<section class="card">
    <div class="heading-row">
        <div>
            <h1>All registrations</h1>
            <p class="lead">@Model.Registrations.Count record(s)</p>
        </div>
        <form method="get" class="search-form">
            <input asp-for="Search" placeholder="Search by ID, name or email" />
            <button class="btn btn-secondary" type="submit">Search</button>
        </form>
    </div>

    <table>
        <thead>
            <tr><th>Registration</th><th>Delegate</th><th>Category</th><th>Amount</th><th>Payment</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Registrations)
            {
                <tr>
                    <td><strong>@item.Id</strong><br /><small>@item.CreatedAt.ToString("dd MMM yyyy")</small>
                        @if (!string.IsNullOrWhiteSpace(item.PaymentBatchId))
                        {
                            <br /><small>Batch @item.PaymentBatchId</small>
                        }
                    </td>
                    <td>@item.FullName<br /><small>@item.Email</small></td>
                    <td>@Model.CategoryName(item.Category)</td>
                    <td>@(item.Currency == "USD" ? "$" : "\u20B9") @item.TotalAmount.ToString("N2")</td>
                    <td>
                        <span class="status @item.PaymentStatus.Replace(" ", "-").ToLowerInvariant()">@item.PaymentStatus</span>
                        @if (!string.IsNullOrWhiteSpace(item.TransactionId))
                        {
                            <br /><small>@item.TransactionId</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.PaymentReference))
                        {
                            <br /><small>@item.PaymentReference</small>
                        }
                    </td>
                    <td class="row-actions">
                        <a asp-page="/Register/Confirmation" asp-route-id="@item.Id">Details</a>
                        @if (item.PaymentStatus != Models.PaymentStates.Paid)
                        {
                            <form method="post" asp-page-handler="MarkPaid" asp-route-id="@item.Id" class="inline-form">
                                <button class="link-button" type="submit">Mark paid</button>
                            </form>
                            @if (!string.IsNullOrWhiteSpace(item.PaymentBatchId))
                            {
                                <form method="post" asp-page-handler="VerifyBatch" asp-route-batchId="@item.PaymentBatchId" class="inline-form">
                                    <button class="link-button" type="submit">Verify batch</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
