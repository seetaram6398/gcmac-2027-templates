@page
@model EmailLoginModel
@{
    ViewData["Title"] = "Delegate login";
}

<section class="page-hero has-banner" style='--page-banner: url("@Url.Content("~/img/banner/inner-registration.png")")'>
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a asp-page="/Index">Home</a><span>/</span><a asp-page="/Register/Category">Registration</a><span>/</span><span aria-current="page">Delegate login</span>
        </nav>
        <h1>Delegate login</h1>
        <p>Sign in with your GCMAC 2027 account to continue your registration or to view your registrations.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="form-shell reveal">
            <div class="form-panel-head">
                <span class="form-badge">01</span>
                <div>
                    <h2>Login for other delegate categories</h2>
                    <p>Use the account you created for GCMAC 2027 registrations.</p>
                </div>
            </div>
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="validation"></div>
                <div class="form-grid">
                    <div class="field field-full">
                        <label for="delegate-email">Email <span class="required" aria-hidden="true">*</span></label>
                        <input id="delegate-email" asp-for="Email" type="email" autocomplete="email" required />
                    </div>
                    <div class="field field-full">
                        <label for="delegate-password">Password <span class="required" aria-hidden="true">*</span></label>
                        <input id="delegate-password" asp-for="Password" type="password" autocomplete="current-password" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Login</button>
                    <a class="btn btn-secondary" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
                    <a class="btn btn-secondary" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">CMA member login</a>
                </div>
            </form>
        </div>
    </div>
</section>
