@page
@model StudentLoginModel
@{
    ViewData["Title"] = "Student login";
}

<section class="page-hero has-banner" style='--page-banner: url("@Url.Content("~/img/banner/inner-registration.png")")'>
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a asp-page="/Index">Home</a><span>/</span><a asp-page="/Register/Category">Registration</a><span>/</span><a asp-page="/Register/Category">Payment &amp; Registration</a><span>/</span><span aria-current="page">Students</span>
        </nav>
        <h1>Students</h1>
        <p>Sign in with your student registration number and date of birth to register at the student rate.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="form-shell reveal">
            <div class="form-panel-head">
                <span class="form-badge">03</span>
                <div>
                    <h2>Login for Students</h2>
                    <p>Use the credentials from your ICMAI student registration account.</p>
                </div>
            </div>
            <div class="notice" role="note">
                <strong>Instructions for Login</strong>
                <ul>
                    <li>Enter your ICMAI student registration number and date of birth.</li>
                    <li>Current demo security code: 123456.</li>
                    <li>For a forgotten password, please contact the GCMAC 2027 secretariat.</li>
                </ul>
            </div>
            <form method="post">
                <div asp-validation-summary="All" class="validation"></div>
                <div class="form-grid">
                    <div class="field">
                        <label for="student-regno">Registration No. <span class="required" aria-hidden="true">*</span></label>
                        <input id="student-regno" asp-for="RegistrationNo" maxlength="12" required />
                    </div>
                    <div class="field">
                        <label for="student-dob">Date of Birth (DD/MM/YYYY) <span class="required" aria-hidden="true">*</span></label>
                        <input id="student-dob" asp-for="DateOfBirth" inputmode="numeric" placeholder="DD/MM/YYYY" pattern="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}" required />
                    </div>
                    <div class="field field-full">
                        <label for="student-captcha">Security Code <span class="required" aria-hidden="true">*</span></label>
                        <input id="student-captcha" asp-for="SecurityCode" autocomplete="off" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Login</button>
                    <a class="btn btn-secondary" asp-page="/Register/Category">Back to categories</a>
                </div>
            </form>
        </div>
    </div>
</section>
