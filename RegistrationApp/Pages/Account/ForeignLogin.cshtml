@page
@model ForeignLoginModel
@{
    ViewData["Title"] = "Foreign delegate login";
}

<section class="page-hero has-banner" style='--page-banner: url("@Url.Content("~/img/banner/inner-registration.png")")'>
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a asp-page="/Index">Home</a><span>/</span><a asp-page="/Register/Category">Registration</a><span>/</span><a asp-page="/Register/Category">Payment &amp; Registration</a><span>/</span><span aria-current="page">Foreign Delegates</span>
        </nav>
        <h1>Foreign Delegates</h1>
        <p>New delegate registration and login for overseas participants attending GCMAC 2027.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="form-shell reveal">
            <div class="form-panel-head">
                <span class="form-badge">04</span>
                <div>
                    <h2>Login for Foreign Delegates</h2>
                    <p>Use the credentials from your GCMAC 2027 registration account.</p>
                </div>
            </div>
            <div class="notice" role="note">
                <strong>Instructions for Login</strong>
                <ul>
                    <li>Use the email id and password of your registration account.</li>
                    <li>Current demo password and security code: 123456.</li>
                    <li>For a forgotten password, please contact the GCMAC 2027 secretariat.</li>
                </ul>
            </div>
            <form method="post">
                <div asp-validation-summary="All" class="validation"></div>
                <div class="form-grid">
                    <div class="field field-full">
                        <label for="foreign-email">Signatory's Email ID <span class="required" aria-hidden="true">*</span></label>
                        <input id="foreign-email" asp-for="Email" type="email" autocomplete="email" required />
                    </div>
                    <div class="field">
                        <label for="foreign-password">Password <span class="required" aria-hidden="true">*</span></label>
                        <input id="foreign-password" asp-for="Password" type="password" autocomplete="current-password" required />
                    </div>
                    <div class="field">
                        <label for="foreign-captcha">Security Code <span class="required" aria-hidden="true">*</span></label>
                        <input id="foreign-captcha" asp-for="SecurityCode" autocomplete="off" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Login</button>
                    <a class="btn btn-secondary" asp-page="/Register/Category">Back to categories</a>
                </div>
            </form>
        </div>
    </div>
</section>
