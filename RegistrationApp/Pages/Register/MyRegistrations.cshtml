@page
@model MyRegistrationsModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "My registrations";
}

<section class="card">
    <div class="heading-row">
        <div>
            <h1>My registrations</h1>
            <p class="lead">All registrations linked to @Model.AccountEmail</p>
        </div>
        <div class="actions">
            <a class="btn btn-primary" asp-page="Category">New registration</a>
            @if (!string.IsNullOrWhiteSpace(HttpContext.Session.GetString(SessionKeys.VerifiedMemberNo)))
            {
                <a class="btn btn-secondary" asp-page="AddDelegate">Add delegate</a>
            }
            else
            {
                <a class="btn btn-secondary" asp-page="/Account/VerifyMember" asp-route-returnUrl="/Register/MyRegistrations">Verify ICMAI membership</a>
            }
        </div>
    </div>

    @if (!Model.Registrations.Any())
    {
        <p class="note">You have not submitted any registrations yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Registration</th><th>Delegate</th><th>Category</th><th>Amount</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Registrations)
                {
                    <tr>
                        <td><strong>@item.Id</strong><br /><small>@item.CreatedAt.ToString("dd MMM yyyy")</small></td>
                        <td>@item.FullName</td>
                        <td>@Model.CategoryName(item.Category)</td>
                        <td>@(item.Currency == "USD" ? "$" : "\u20B9") @item.TotalAmount.ToString("N2")</td>
                        <td><span class="status @item.PaymentStatus.Replace(" ", "-").ToLowerInvariant()">@item.PaymentStatus</span></td>
                        <td class="row-actions">
                            @if (item.PaymentStatus != Models.PaymentStates.Paid)
                            {
                                <a asp-page="Payment" asp-route-id="@item.Id">Pay</a>
                            }
                            <a asp-page="Confirmation" asp-route-id="@item.Id">Details</a>
                            <a asp-page="Receipt" asp-route-id="@item.Id">Receipt</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
