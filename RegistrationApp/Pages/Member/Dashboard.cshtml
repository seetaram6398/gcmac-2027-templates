@page
@model DashboardModel
@{
    ViewData["Title"] = "Member dashboard";
}

<section class="page-hero has-banner" style='--page-banner: url("@Url.Content("~/img/banner/inner-registration.png")")'>
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a asp-page="/Index">Home</a><span>/</span><span aria-current="page">Member dashboard</span>
        </nav>
        <h1>Member dashboard</h1>
        <p>Manage your GCMAC 2027 registration, add delegates and complete payments from one place.</p>
    </div>
</section>

<section class="section member-page">
    <div class="container member-layout">
        @await Html.PartialAsync("_MemberSidebar")
        <div class="member-content">
        @if (Model.Member is not null)
        {
            <div class="dash-grid reveal">
                <div class="dash-card">
                    <span class="eyebrow">Verified member</span>
                    <h2>@Model.Member.Name</h2>
                    <p>Membership No: <strong>@Model.Member.MemberNo</strong></p>
                    <p>Email: @Model.Member.Email</p>
                    <p>Mobile: @Model.Member.Mobile</p>
                    <p class="hint">Email verified: @(Model.Member.EmailVerified ? "Yes" : "No") · Mobile verified: @(Model.Member.MobileVerified ? "Yes" : "No")</p>
                </div>
                <div class="dash-card">
                    <span class="eyebrow">Your panel</span>
                    <h2>What would you like to do?</h2>
                    <div class="dash-actions">
                        <a class="btn btn-primary" asp-page="/Register/Form" asp-route-category="CmaPractice">Register for the event</a>
                        <a class="btn btn-secondary" asp-page="/Register/AddDelegate">Add delegate</a>
                        <a class="btn btn-secondary" asp-page="/Register/MyRegistrations">My registrations &amp; payment</a>
                        <a class="btn btn-secondary" asp-page="/Register/Category">Other categories</a>
                    </div>
                    <p class="hint">You can add up to @Model.DelegateLimit delegates against this membership.</p>
                </div>
            </div>

            <div class="dash-section reveal">
                <div class="section-head">
                    <p class="eyebrow">Delegates added by you</p>
                    <h2>Sponsored delegates</h2>
                    <p>@Model.Delegates.Count of @Model.DelegateLimit delegates added.</p>
                </div>
                @if (Model.Delegates.Count == 0)
                {
                    <div class="notice" role="status">No delegates added yet. <a asp-page="/Register/AddDelegate">Add your first delegate</a>.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Registration</th><th>Delegate</th><th>Category</th><th>Payment</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.Delegates)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.FullName<br /><span class="hint">@item.Email</span></td>
                                        <td>@DashboardModel.CategoryName(item.Category)</td>
                                        <td><span class="status status-@item.PaymentStatus.ToLowerInvariant()">@item.PaymentStatus</span></td>
                                        <td><a asp-page="/Register/Payment" asp-route-id="@item.Id">Pay / view</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="dash-section reveal">
                <div class="section-head">
                    <p class="eyebrow">Your registrations</p>
                    <h2>Member and delegate registrations</h2>
                </div>
                @if (Model.MyRegistrations.Count == 0)
                {
                    <div class="notice" role="status">You have not made any registration yet. <a asp-page="/Register/Form" asp-route-category="CmaPractice">Register now</a>.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Registration</th><th>Category</th><th>Amount</th><th>Payment</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRegistrations)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@DashboardModel.CategoryName(item.Category)</td>
                                        <td>@item.TotalAmount</td>
                                        <td><span class="status status-@item.PaymentStatus.ToLowerInvariant()">@item.PaymentStatus</span></td>
                                        <td><a asp-page="/Register/Payment" asp-route-id="@item.Id">Pay / view</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        </div>
    </div>
</section>
