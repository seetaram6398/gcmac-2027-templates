@page
@model DashboardModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Member dashboard";
    var memberName = Model.Member?.Name ?? "Member";
    var nameParts = memberName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var firstName = nameParts.Length > 0 ? nameParts[0] : "Member";
    var pending = 0;
    foreach (var item in Model.MyRegistrations)
    {
        if (item.PaymentStatus != "Paid") pending++;
    }
    foreach (var item in Model.Delegates)
    {
        if (item.PaymentStatus != "Paid") pending++;
    }
}

@if (Model.Member is not null)
{
    <section class="member-hero-card">
        <div>
            <span class="member-hero-kicker"><i></i>Verified ICMAI member</span>
            <h1>Hello, @firstName</h1>
            <p>Your GCMAC 2027 workspace is ready. Register yourself, sponsor delegates and track every payment from one place.</p>
            <div class="member-hero-meta">
                <span><b>Membership no.</b>@Model.Member.MemberNo</span>
                <span><b>Email</b>@Model.Member.Email</span>
                <span><b>Mobile</b>@Model.Member.Mobile</span>
            </div>
        </div>
        <div class="member-verified-card">
            <span class="member-verified-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg></span>
            <strong>Profile verified</strong>
            <p>Email and mobile confirmed through secure OTP verification.</p>
            <span class="badge">Verified member</span>
        </div>
    </section>

    <div class="member-stat-grid">
        <div class="member-stat">
            <span class="member-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v6h5M10 13h6M10 17h6"/></svg></span>
            <span class="member-stat-copy"><span>Member registrations</span><strong>@Model.MyRegistrations.Count</strong></span>
        </div>
        <div class="member-stat">
            <span class="member-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M18 8v6M15 11h6"/></svg></span>
            <span class="member-stat-copy"><span>Sponsored delegates</span><strong>@Model.Delegates.Count / @Model.DelegateLimit</strong></span>
        </div>
        <div class="member-stat">
            <span class="member-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span class="member-stat-copy"><span>Pending payments</span><strong>@pending</strong></span>
        </div>
    </div>

    <div class="member-action-grid">
        <a class="member-action" asp-page="/Register/Form" asp-route-category="CmaPractice">
            <span><strong>Register for the event</strong><small>Complete your member delegate registration.</small></span>
            <span class="member-action-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="member-action" asp-page="/Register/AddDelegate">
            <span><strong>Add a delegate</strong><small>Sponsor another delegate under your membership.</small></span>
            <span class="member-action-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="member-action" asp-page="/Register/MyRegistrations">
            <span><strong>My registrations &amp; payment</strong><small>Review registrations and complete payments.</small></span>
            <span class="member-action-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="member-action" asp-page="/Register/Category">
            <span><strong>Other categories</strong><small>Explore corporate, student, foreign and spouse options.</small></span>
            <span class="member-action-arrow" aria-hidden="true">&rarr;</span>
        </a>
    </div>

    <section class="member-section-card">
        <div class="section-head">
            <p class="eyebrow">Sponsored delegates</p>
            <h2>Delegates added by you</h2>
            <p>@Model.Delegates.Count of @Model.DelegateLimit delegates added.</p>
        </div>
        @if (Model.Delegates.Count == 0)
        {
            <div class="notice" role="status">No delegates added yet. <a asp-page="/Register/AddDelegate">Add your first delegate</a>.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Registration</th><th>Delegate</th><th>Category</th><th>Payment</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Delegates)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.FullName<br /><span class="hint">@item.Email</span></td>
                                <td>@DashboardModel.CategoryName(item.Category)</td>
                                <td><span class="status status-@item.PaymentStatus.ToLowerInvariant()">@item.PaymentStatus</span></td>
                                <td><a asp-page="/Register/Payment" asp-route-id="@item.Id">Pay / view</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="member-section-card">
        <div class="section-head">
            <p class="eyebrow">Your registrations</p>
            <h2>Member and delegate registrations</h2>
        </div>
        @if (Model.MyRegistrations.Count == 0)
        {
            <div class="notice" role="status">You have not made any registration yet. <a asp-page="/Register/Form" asp-route-category="CmaPractice">Register now</a>.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Registration</th><th>Category</th><th>Amount</th><th>Payment</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.MyRegistrations)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@DashboardModel.CategoryName(item.Category)</td>
                                <td>@item.TotalAmount</td>
                                <td><span class="status status-@item.PaymentStatus.ToLowerInvariant()">@item.PaymentStatus</span></td>
                                <td><a asp-page="/Register/Payment" asp-route-id="@item.Id">Pay / view</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
