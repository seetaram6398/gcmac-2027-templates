@{
    var verifiedMember = !string.IsNullOrWhiteSpace(Context.Session.GetString(SessionKeys.VerifiedMemberNo));
    var loggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString(SessionKeys.Email));
    var isAdmin = Context.Session.GetString(SessionKeys.IsAdmin) == "true";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GCMAC 2027</title>
    <meta name="description" content="GCMAC 2027, the Global Cost and Management Accountants' Convention, 12–14 February 2027 at The Ashok, New Delhi. Strategic CMAs for a Resilient World: Leadership, Governance and Sustainable Value." />
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/style.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/shared.js" defer></script>
    <script src="~/motion.js" defer></script>
    <script src="~/js/site.js" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="announce-bar">
        <div class="announce-track">
            <span>GCMAC 2027 · 12–14 February 2027 · The Ashok, New Delhi</span>
            <span>Early Bird registration closes 15 December 2026</span>
            <span>CPE Credit: 10 Hours</span>
            <span>GCMAC 2027 · 12–14 February 2027 · The Ashok, New Delhi</span>
            <span>Early Bird registration closes 15 December 2026</span>
            <span>CPE Credit: 10 Hours</span>
        </div>
    </div>

    <div class="page-bg" aria-hidden="true">
        <span class="glow g1"></span>
        <span class="glow g2"></span>
        <span class="glow g3"></span>
    </div>

    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-page="/Index" aria-label="GCMAC 2027 home">
                <span class="brand-logo-wrap">
                    <img class="brand-logo" src="~/img/icmai-header-logo.svg" alt="The Institute of Cost Accountants of India logo" />
                </span>
                <span class="brand-divider" aria-hidden="true"></span>
                <span class="topbar-emblem"><img src="~/img/gcmac-2027-logo-square.png" alt="GCMAC 2027 emblem" /></span>
            </a>
            <nav class="site-nav" id="siteNav" aria-label="Primary">
                <a class="nav-home" aria-label="Home" href="~/index.html">
                    <svg class="nav-home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9.5 21v-6h5v6"/></svg>
                </a>
                <a href="~/index.html">Home</a>
                <a href="~/about-icmai.html">About</a>
                <div class="nav-group">
                    <button class="nav-parent" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="gcmacSubmenu">GCMAC-2027 <span class="nav-caret" aria-hidden="true"></span></button>
                    <div class="submenu" id="gcmacSubmenu">
                        <a href="~/about.html">About GCMAC</a>
                        <a href="~/leadership.html#patrons">Patrons &amp; Leadership</a>
                        <a href="~/organising-committee.html">Organising Committee</a>
                        <a href="~/technical-committee.html">Technical Committee</a>
                        <a href="~/venue.html">Venue</a>
                    </div>
                </div>
                <a href="~/programme.html#pillars">Program Schedule</a>
                <a href="~/important-dates.html">Important Dates</a>
                <a href="~/sponsorship.html">Sponsorship</a>
                <a asp-page="/Register/Category">Registration</a>
                <a href="~/contact.html">Contact Us</a>
                <div class="nav-mobile-account">
                    @if (loggedIn)
                    {
                        <a asp-page="/Register/MyRegistrations">My Registrations</a>
                        if (verifiedMember)
                        {
                            <a asp-page="/Register/AddDelegate">Add delegate</a>
                        }
                        else
                        {
                            <a asp-page="/Account/VerifyMember" asp-route-returnUrl="/Register/AddDelegate">Verify membership</a>
                        }
                        if (isAdmin)
                        {
                            <a asp-page="/Admin/Index">Admin</a>
                        }
                        <a asp-page="/Account/Logout">Logout</a>
                    }
                    else
                    {
                        <a asp-page="/Register/Track">Track</a>
                        <a asp-page="/Account/Login">Login</a>
                    }
                </div>
            </nav>
            <div class="topbar-actions">
                @if (loggedIn)
                {
                    <a class="nav-account" asp-page="/Register/MyRegistrations">My Registrations</a>
                    if (verifiedMember)
                    {
                        <a class="nav-account" asp-page="/Register/AddDelegate">Add delegate</a>
                    }
                    else
                    {
                        <a class="nav-account" asp-page="/Account/VerifyMember" asp-route-returnUrl="/Register/AddDelegate">Verify membership</a>
                    }
                    if (isAdmin)
                    {
                        <a class="nav-account" asp-page="/Admin/Index">Admin</a>
                    }
                    <span class="nav-email">@Context.Session.GetString(SessionKeys.Email)</span>
                    <a class="nav-account" asp-page="/Account/Logout">Logout</a>
                }
                else
                {
                    <a class="nav-account" asp-page="/Register/Track">Track</a>
                    <a class="nav-account" asp-page="/Account/Login">Login</a>
                }
                <button class="nav-toggle" type="button" aria-controls="siteNav" aria-expanded="false" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <span class="footer-icmai"><img class="footer-logo-icmai" src="~/img/icmai-header-logo.svg" alt="The Institute of Cost Accountants of India logo" /></span>
                <p class="footer-brand">GCMAC <b>2027</b></p>
                <p class="footer-tag">Behind every successful business decision, there is always a CMA.</p>
            </div>
            <div>
                <p class="footer-label">Convention</p>
                <a asp-page="/Index">Home</a>
                <a asp-page="/Register/Category">Registration</a>
                <a asp-page="/Register/Track">Track a registration</a>
            </div>
            <div>
                <p class="footer-label">Participate</p>
                <a asp-page="/Register/Category">Delegate categories</a>
                <a asp-page="/Account/MemberSignup">Member signup</a>
                <a asp-page="/Member/Dashboard">Member dashboard</a>
                <a asp-page="/Register/MyRegistrations">My Registrations</a>
                <a asp-page="/Account/EmailLogin">Delegate login</a>
                <a href="mailto:gcmac2027@icmai.in">Payment help</a>
            </div>
            <div>
                <p class="footer-label">Contact</p>
                <a href="mailto:gcmac2027@icmai.in">gcmac2027@icmai.in</a>
                <a href="https://www.icmai.in" target="_blank" rel="noopener">www.icmai.in</a>
                <span>CPE Credit: 10 Hours</span>
                <p class="footer-disclaimer">In the event of unforeseen circumstances or factors beyond ICMAI's control necessitating the cancellation or rescheduling of the event, we retain the right to do so without assuming any financial or legal liability. We will promptly notify registered participants of any event cancellation or rescheduling via email.</p>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>© 2027 The Institute of Cost Accountants of India</span>
            <span>GCMAC 2027 · 12–14 February 2027 · The Ashok, New Delhi</span>
        </div>
    </footer>
</body>
</html>
