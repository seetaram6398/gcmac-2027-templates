@{
    var rawName = Context.Session.GetString(SessionKeys.VerifiedMemberName);
    var memberName = string.IsNullOrWhiteSpace(rawName) ? "Member" : rawName;
    var memberNo = Context.Session.GetString(SessionKeys.VerifiedMemberNo) ?? "";
    var nameParts = memberName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = ((nameParts.Length > 0 ? nameParts[0][0] : 'M').ToString() + (nameParts.Length > 1 ? nameParts[1][0] : ' ')).Trim().ToUpperInvariant();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string IsActive(string path) => currentPage.Equals(path, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}
